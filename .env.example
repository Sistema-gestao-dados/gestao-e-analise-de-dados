# Copie este arquivo para ".env" (ou configure as mesmas variáveis nas
# "Environment Variables" da Vercel) e preencha com os dados do SEU projeto
# Supabase novo (Project Settings > API, no painel do Supabase).
#
# IMPORTANTE: SUPABASE_SERVICE_ROLE_KEY é secreta — nunca exponha no
# navegador nem em variáveis que comecem com VITE_. Ela só é usada no
# servidor (src/integrations/supabase/client.server.ts).

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# As variáveis abaixo são as mesmas de cima, mas com prefixo VITE_ para
# ficarem disponíveis no código que roda no navegador.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
